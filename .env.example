# Renovo Surface Solutions — environment configuration
#
# Copy to .env for local work, or set these in Netlify:
#   Site configuration -> Environment variables
#
# .env is gitignored. Never commit real values. This file holds placeholders only.


# ---------------------------------------------------------------------------
# REQUIRED — the app throws without these
# ---------------------------------------------------------------------------

# Signs the admin and client-portal session cookies. Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs everyone out immediately.
SESSION_SECRET=

# The admin area password, compared in constant time. Choose a long one —
# this is the only credential guarding every estimate, invoice and client record.
ADMIN_PASSWORD=


# ---------------------------------------------------------------------------
# PAYMENTS — without these, invoices work but nobody can pay online
# ---------------------------------------------------------------------------

# Stripe Dashboard -> Developers -> API keys -> Secret key
# Use the sk_test_... key until you have gone through a full test payment.
STRIPE_SECRET_KEY=

# Stripe Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret
# Endpoint URL: https://<your-site>/api/stripe-webhook
# Subscribe the endpoint to exactly these three events:
#   checkout.session.completed
#   payment_intent.succeeded
#   payment_intent.payment_failed
# This is NOT the API key. Without it every webhook is rejected with 503 and
# invoices never flip to Paid, even though the customer was charged.
STRIPE_WEBHOOK_SECRET=


# ---------------------------------------------------------------------------
# EMAIL — without this, sends are skipped and logged, not failed
# ---------------------------------------------------------------------------

# Resend Dashboard -> API Keys
RESEND_API_KEY=


# ---------------------------------------------------------------------------
# OPTIONAL — code falls back to the value shown if unset
# ---------------------------------------------------------------------------

# default: Renovo Surface Solutions <notifications@renovosurface.com>
# Must be a domain you have verified in Resend or delivery will fail.
RESEND_FROM_EMAIL=

# default: Pngoy@renovosurface.com
# Where "estimate viewed / approved / signed" alerts land.
ADMIN_NOTIFY_EMAIL=

# default: https://renovosurface.com
# Used to build client-facing links in emails and PDFs. Set this for local work
# (e.g. http://localhost:8888) or emailed links will point at production.
SITE_URL=


# ---------------------------------------------------------------------------
# PROVISIONED AUTOMATICALLY — do not set by hand
# ---------------------------------------------------------------------------
# NETLIFY_DATABASE_URL is injected by Netlify DB and used by drizzle.config.ts.
